{
  "name": "5vinci-optimizer",
  "version": "2.0.0",
  "description": "5VINCI Optimizer: ускорение и очистка Windows + мониторинг",
  "main": "main.js",
  "author": "5VINCI",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "systeminformation": "^5.23.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "@electron/fuses": "^1.8.0"
  },
  "build": {
    "appId": "com.vinci5.optimizer",
    "productName": "5VINCI Optimizer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "tweaks.js",
      "license.js",
      "pubkey.js",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "5VINCI Optimizer",
      "artifactName": "5VINCI-Optimizer-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "5VINCI-Optimizer-Portable-${version}.${ext}"
    },
    "afterPack": "./afterPack.js",
    "asar": true,
    "compression": "maximum"
  }
}